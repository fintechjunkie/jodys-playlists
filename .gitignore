# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env*.local

# Generated cover assets — rebuild with `npm run covers` from art/inbox/
/art/spotify/*.jpg

# Generated pins — rebuild with `npm run pins` from art/pins/inbox/
/art/pins/out/

# Treatment mockups — rebuild with `npm run pins -- --variants`
/art/pins/variants/
